# ============================================================
# DigiLib - Docker Environment Variables
# Sao chép file này thành .env (cùng cấp docker-compose.yml)
# rồi điền thông tin thật trước khi chạy: docker compose up
# ============================================================

# --- Django ---
# Tạo SECRET_KEY mới tại: https://djecrety.ir/
SECRET_KEY=django-insecure-changeme-in-production
DEBUG=True
ALLOWED_HOSTS=localhost 127.0.0.1

# --- MySQL Database ---
DB_NAME=librarydb
DB_PASSWORD=change_this_password
DB_USER=digilib

# --- RabbitMQ ---
RABBITMQ_USER=digilib_rabbit
RABBITMQ_PASS=change_this_rabbit_password

# --- Cloudinary (lưu ảnh bìa sách) ---
# Lấy tại: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Email (Gmail SMTP) ---
# Tạo App Password tại: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16char_app_password
